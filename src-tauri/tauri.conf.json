{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHistory",
  "version": "0.1.0",
  "identifier": "io.openhistory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "compact",
        "title": "OpenHistory",
        "url": "index.html?surface=compact",
        "width": 380,
        "height": 560,
        "minWidth": 340,
        "minHeight": 420,
        "maxWidth": 420,
        "maxHeight": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": true
      },
      {
        "label": "history",
        "title": "OpenHistory",
        "url": "index.html?surface=history",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-only semantic activity history",
    "longDescription": "OpenHistory turns consented semantic desktop activity into private, resumable work context.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
